# Token del bot de Discord (obtenido en https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here

# Nombre del modelo Ollama a usar (ej: llama3, mistral, gemma2)
OLLAMA_MODEL=gemma-aggressive

# (Opcional) URL del servidor Ollama si no es el predeterminado
OLLAMA_HOST=http://localhost:11434

# (Opcional) Modelo de Whisper a usar: tiny, base, small, medium, large-v3
WHISPER_MODEL=medium

# (Opcional) Idioma forzado para ASR: "es", "en", o dejar vacío para auto-detección
ASR_LANGUAGE=

# (Opcional) Modelo TTS de Hugging Face para síntesis de voz en español
TTS_MODEL=facebook/mms-tts-spa

# (Opcional) Forzar el modelo TTS a CPU aunque haya GPU disponible (útil si la VRAM es justa)
# Establece a "1" para activar
TTS_FORCE_CPU=
